{
  "name": "cdd-ops",
  "version": "0.0.1",
  "description": "CDD Platform Operations (cdd-ops): Infrastructure, orchestration, and E2E testing for Compiler Driven Development.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "tsx scripts/test.ts",
    "deploy": "tsx scripts/deploy.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelMarks/cdd-ops.git"
  },
  "keywords": [
    "cdd",
    "openapi",
    "operations",
    "libscript",
    "playwright"
  ],
  "author": "Samuel Marks",
  "license": "Apache-2.0 OR MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SamuelMarks/cdd-ops/issues"
  },
  "homepage": "https://github.com/SamuelMarks/cdd-ops#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-jsdoc": "^63.0.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
