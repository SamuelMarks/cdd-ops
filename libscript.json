{
  "$schema": "../libscript/libscript.schema.json",
  "name": "cdd",
  "version": "0.0.5",
  "description": "Compiler Driven Development (CDD) Platform Stack",
  "deps": {
    "rust": "latest",
    "nodejs": "latest",
    "postgres": "latest",
    "valkey": "latest",
    "nginx": "latest",
    "wait4x": "latest"
  },
  "install": {
    "dependencies": {
      "required": {
        "toolchains": [
          { "name": "rust", "version": "latest" },
          { "name": "nodejs", "version": "latest" },
          { "name": "wait4x", "version": "latest" }
        ],
        "databases": [
          { "name": "postgres", "version": "latest", "ports": [5432] },
          { "name": "valkey", "version": "latest", "ports": [6379] }
        ],
        "servers": [
          { "name": "nginx", "version": "latest", "ports": [8080] }
        ]
      }
    }
  },
  "dependencies": {
    "required": {
      "toolchains": [
        { "name": "rust", "version": "latest" },
        { "name": "nodejs", "version": "latest" },
        { "name": "wait4x", "version": "latest" }
      ],
      "databases": [
        { "name": "postgres", "version": "latest", "ports": [5432] },
        { "name": "valkey", "version": "latest", "ports": [6379] }
      ],
      "servers": [
        { "name": "nginx", "version": "latest", "ports": [8080] }
      ]
    }
  },
  "vars": {
    "POSTGRES_PORT": 5432,
    "POSTGRES_USER": "postgres",
    "POSTGRES_DB": "cdd",
    "VALKEY_PORT": 6379,
    "CADDY_PORT_HTTP": 8080,
    "NGINX_PORT": 8080,
    "GITHUB_ORG_NAME": "offscale"
  },
  "databases": [
    {
      "id": "cdd-postgres",
      "engine": "postgres",
      "host": "localhost",
      "port": 5432,
      "db": "cdd",
      "user": "postgres",
      "url_env": "CDD__DATABASE_URL",
      "migrations": [
        {
          "cwd": "../cdd-control-plane",
          "command": "diesel migration run"
        }
      ]
    },
    {
      "id": "cdd-valkey",
      "engine": "valkey",
      "host": "localhost",
      "port": 6379,
      "url_env": "CDD__REDIS_URL"
    }
  ],
  "frontends": [
    {
      "name": "cdd-docs-ui",
      "framework": "angular",
      "cwd": "../cdd-docs-ui",
      "install_command": "npm install",
      "build_command": "npm run build",
      "dist_dir": "dist",
      "artifact_check": "../cdd-docs-ui/dist",
      "serve": {
        "server": "nginx",
        "port": 8082,
        "spa_fallback": true
      }
    },
    {
      "name": "cdd-web-ui",
      "framework": "angular",
      "cwd": "../cdd-web-ui",
      "install_command": "npm install",
      "build_command": "npm run build",
      "dist_dir": "dist/cdd-web-ui/browser",
      "artifact_check": "../cdd-web-ui/dist/cdd-web-ui/browser/index.html",
      "serve": {
        "server": "nginx",
        "port": 8083,
        "spa_fallback": true
      }
    }
  ],
  "hooks": {
    "build": [
      {
        "name": "install-ops-deps",
        "command": "npm install",
        "artifact_check": "node_modules"
      },
      {
        "name": "build-microservices",
        "command": "npm run deploy",
        "artifact_check": "../bin"
      }
    ],
    "pre_start": [
      {
        "name": "wait-postgres",
        "command": "wait4x postgresql \"postgres://postgres@localhost:5432/postgres?sslmode=disable\" -t 60s"
      },
      {
        "name": "wait-valkey",
        "command": "wait4x redis \"redis://localhost:6379\" -t 60s"
      },
      {
        "name": "ensure-cdd-database",
        "command": "psql -h localhost -U postgres -c \"CREATE DATABASE cdd\"",
        "ignore_errors": true
      }
    ],
    "post_start": [
      {
        "name": "verify-gateway-health",
        "command": "wait4x http \"http://localhost:8086/health\" -t 60s"
      }
    ]
  },
  "services": [
    {
      "name": "cdd-control-plane",
      "command": "../bin/cdd-control-plane",
      "cwd": ".",
      "port": 8081,
      "health_url": "http://localhost:8081/health",
      "health_timeout": 60,
      "depends_on": ["postgres", "valkey"],
      "env": {
        "CDD__DATABASE_URL": "postgres://postgres@localhost:5432/cdd",
        "CDD__REDIS_URL": "redis://localhost:6379",
        "CDD__SERVER_BIND": "0.0.0.0:8081",
        "CDD__GOOGLE_CLIENT_ID": "dev-google-client-id",
        "CDD__GOOGLE_CLIENT_SECRET": "dev-google-client-secret",
        "CDD__GOOGLE_OAUTH_URL": "https://oauth2.googleapis.com/token",
        "CDD__GOOGLE_USERINFO_URL": "https://www.googleapis.com/oauth2/v3/userinfo",
        "CDD__GITHUB_CLIENT_ID": "dev-github-client-id",
        "CDD__GITHUB_CLIENT_SECRET": "dev-github-client-secret",
        "GITHUB_ORG_NAME": "offscale",
        "CDD__STORAGE_URL": "http://localhost:8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key"
      }
    },
    {
      "name": "cdd-engine",
      "command": "../bin/cdd-engine",
      "cwd": ".",
      "depends_on": ["postgres", "valkey", "cdd-control-plane"],
      "env": {
        "CDD__DATABASE_URL": "postgres://postgres@localhost:5432/cdd",
        "CDD__REDIS_URL": "redis://localhost:6379",
        "CDD__WASM_DIR": "../cdd-web-ui/public/wasm",
        "CDD__STORAGE_URL": "http://localhost:8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key"
      }
    },
    {
      "name": "cdd-storage",
      "command": "../bin/cdd-storage",
      "cwd": ".",
      "port": 8085,
      "health_url": "http://localhost:8085/health",
      "health_timeout": 60,
      "depends_on": ["postgres", "valkey"],
      "env": {
        "CDD__DATABASE_URL": "postgres://postgres@localhost:5432/cdd",
        "CDD__REDIS_URL": "redis://localhost:6379",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key",
        "PORT": "8085"
      }
    },
    {
      "name": "cdd-publisher",
      "command": "../bin/cdd-publisher",
      "cwd": ".",
      "depends_on": ["postgres", "valkey", "cdd-storage"],
      "env": {
        "CDD__DATABASE_URL": "postgres://postgres@localhost:5432/cdd",
        "CDD__REDIS_URL": "redis://localhost:6379",
        "CDD__STORAGE_URL": "http://localhost:8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key",
        "CDD__PGP_KEY_ID": "CDD-DEV-PGP-KEY",
        "CDD__PGP_PASSPHRASE": "dev-pgp-passphrase",
        "GITHUB_ORG_NAME": "offscale"
      }
    },
    {
      "name": "cdd-docs-ui",
      "command": "npm run serve",
      "cwd": "../cdd-docs-ui",
      "port": 8082,
      "health_url": "http://localhost:8082",
      "health_timeout": 60,
      "env": {
        "PORT": "8082",
        "CDD__STORAGE_URL": "http://localhost:8085"
      }
    },
    {
      "name": "cdd-web-ui",
      "command": "npx --yes serve -s dist/cdd-web-ui/browser -l 8083",
      "cwd": "../cdd-web-ui",
      "port": 8083,
      "health_url": "http://localhost:8083",
      "health_timeout": 60,
      "env": {
        "PORT": "8083",
        "CDD__WASM_DIR": "../cdd-web-ui/public/wasm"
      }
    },
    {
      "name": "cdd-gateway",
      "command": "../bin/cdd-gateway",
      "cwd": ".",
      "port": 8086,
      "health_url": "http://localhost:8086/health",
      "health_timeout": 60,
      "depends_on": ["cdd-control-plane", "cdd-storage", "cdd-docs-ui", "cdd-web-ui"],
      "env": {
        "CDD__DATABASE_URL": "postgres://postgres@localhost:5432/cdd",
        "CDD__REDIS_URL": "redis://localhost:6379",
        "CDD__SERVER_BIND": "0.0.0.0:8086",
        "CDD__GOOGLE_CLIENT_ID": "dev-google-client-id",
        "CDD__GOOGLE_CLIENT_SECRET": "dev-google-client-secret",
        "CDD__GOOGLE_OAUTH_URL": "https://oauth2.googleapis.com/token",
        "CDD__GOOGLE_USERINFO_URL": "https://www.googleapis.com/oauth2/v3/userinfo",
        "CDD__GITHUB_CLIENT_ID": "dev-github-client-id",
        "CDD__GITHUB_CLIENT_SECRET": "dev-github-client-secret",
        "GITHUB_ORG_NAME": "offscale",
        "CDD__STORAGE_URL": "http://localhost:8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key"
      }
    }
  ]
}
