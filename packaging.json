{
  "$schema": "../libscript/packaging/packaging.schema.json",
  "name": "cdd",
  "title": "Compiler Driven Development (CDD) Platform",
  "version": "0.0.1",
  "publisher": "CDD Open Source Project",
  "upgrade_code": "A7D43B82-6E19-4F0C-9B25-3C8A1D7E4F90",
  "topology": "standalone",
  "database_contracts": [
    {
      "engine": "postgres",
      "min_version": "16.0.0",
      "allow_shared_instance": true,
      "default_schema_name": "cdd",
      "default_user_name": "postgres",
      "default_port": 5432,
      "ssl_required": false,
      "dbaas_supported": true
    },
    {
      "engine": "redis",
      "min_version": "7.0.0",
      "allow_shared_instance": true,
      "default_schema_name": "0",
      "default_user_name": "default",
      "default_port": 6379,
      "ssl_required": false,
      "dbaas_supported": true
    }
  ],
  "services": [
    {
      "id": "cdd-control-plane",
      "type": "custom",
      "port_binding": 8081,
      "environment_overrides": {
        "CDD__SERVER_BIND": "0.0.0.0:8081"
      }
    },
    {
      "id": "cdd-engine",
      "type": "worker"
    },
    {
      "id": "cdd-storage",
      "type": "custom",
      "port_binding": 8085,
      "environment_overrides": {
        "PORT": "8085"
      }
    },
    {
      "id": "cdd-publisher",
      "type": "worker"
    },
    {
      "id": "cdd-docs-ui",
      "type": "static",
      "port_binding": 8082
    },
    {
      "id": "cdd-web-ui",
      "type": "static",
      "port_binding": 8083
    },
    {
      "id": "cdd-gateway",
      "type": "proxy",
      "port_binding": 8086,
      "environment_overrides": {
        "CDD__SERVER_BIND": "0.0.0.0:8086"
      }
    }
  ],
  "directories": {
    "app_default": "[ProgramFiles64Folder][ProductName]",
    "data_default": "[CommonAppDataFolder][ProductName]\\data",
    "logs_default": "[CommonAppDataFolder][ProductName]\\logs",
    "backups_default": "[CommonAppDataFolder][ProductName]\\backups"
  },
  "branding_palette": {
    "primary_color": "#0F172A",
    "secondary_color": "#2563EB",
    "dark_color": "#020617",
    "app_title": "CDD Platform"
  },
  "features": [
    {
      "id": "CoreServices",
      "title": "CDD Core Microservices",
      "description": "Installs Control Plane, Gateway, Engine, Storage, and Publisher services.",
      "default": true,
      "mandatory": true
    },
    {
      "id": "WebInterfaces",
      "title": "CDD Web & Documentation UIs",
      "description": "Installs the Angular Web Dashboard and API Documentation portal.",
      "default": true,
      "mandatory": false
    }
  ],
  "lifecycle_hooks": {
    "pre_install": [
      {
        "id": "verify_ports",
        "description": "Verify required CDD service ports are available",
        "command": "echo Verifying CDD platform prerequisites",
        "optional": true
      }
    ],
    "post_install": [
      {
        "id": "init_cdd_db",
        "description": "Initialize PostgreSQL cdd database",
        "command": "psql -h localhost -U postgres -c \"CREATE DATABASE cdd\"",
        "optional": true
      }
    ]
  }
}
