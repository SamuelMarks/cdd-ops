{
  "$schema": "../libscript/packaging/packaging.schema.json",
  "name": "cdd",
  "title": "Compiler Driven Development (CDD) Platform",
  "version": "0.0.5",
  "publisher": "CDD Open Source Project",
  "upgrade_code": "A7D43B82-6E19-4F0C-9B25-3C8A1D7E4F90",
  "topology": "standalone",
  "database_contracts": [
    {
      "engine": "postgres",
      "min_version": "16.0.0",
      "allow_shared_instance": true,
      "default_schema_name": "cdd",
      "default_user_name": "postgres",
      "default_port": 5432,
      "ssl_required": false,
      "dbaas_supported": true
    },
    {
      "engine": "redis",
      "min_version": "7.0.0",
      "allow_shared_instance": true,
      "default_schema_name": "0",
      "default_user_name": "default",
      "default_port": 6379,
      "ssl_required": false,
      "dbaas_supported": true
    }
  ],
  "services": [
    {
      "id": "cdd-control-plane",
      "type": "custom",
      "binary_Or_Entrypoint": "bin/cdd-control-plane",
      "args": [],
      "working_directory": ".",
      "port_binding": 8081,
      "environment_overrides": {
        "CDD__SERVER_BIND": "0.0.0.0:8081",
        "CDD__GOOGLE_CLIENT_ID": "dev-google-client-id",
        "CDD__GOOGLE_CLIENT_SECRET": "dev-google-client-secret",
        "CDD__GOOGLE_OAUTH_URL": "https://oauth2.googleapis.com/token",
        "CDD__GOOGLE_USERINFO_URL": "https://www.googleapis.com/oauth2/v3/userinfo",
        "CDD__GITHUB_CLIENT_ID": "dev-github-client-id",
        "CDD__GITHUB_CLIENT_SECRET": "dev-github-client-secret",
        "GITHUB_ORG_NAME": "offscale",
        "CDD__STORAGE_URL": "http://localhost:8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key"
      },
      "health_check": {
        "type": "http",
        "endpoint": "http://localhost:8081/health",
        "interval_seconds": 10,
        "retries": 6
      }
    },
    {
      "id": "cdd-engine",
      "type": "worker",
      "binary_Or_Entrypoint": "bin/cdd-engine",
      "args": [],
      "working_directory": ".",
      "environment_overrides": {
        "CDD__WASM_DIR": "cdd-web-ui/public/wasm",
        "CDD__STORAGE_URL": "http://localhost:8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key"
      },
      "health_check": {
        "type": "command",
        "endpoint": "echo ok",
        "interval_seconds": 30,
        "retries": 3
      }
    },
    {
      "id": "cdd-storage",
      "type": "custom",
      "binary_Or_Entrypoint": "bin/cdd-storage",
      "args": [],
      "working_directory": ".",
      "port_binding": 8085,
      "environment_overrides": {
        "PORT": "8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key"
      },
      "health_check": {
        "type": "http",
        "endpoint": "http://localhost:8085/health",
        "interval_seconds": 10,
        "retries": 6
      }
    },
    {
      "id": "cdd-publisher",
      "type": "worker",
      "binary_Or_Entrypoint": "bin/cdd-publisher",
      "args": [],
      "working_directory": ".",
      "environment_overrides": {
        "CDD__STORAGE_URL": "http://localhost:8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key",
        "CDD__PGP_KEY_ID": "CDD-DEV-PGP-KEY",
        "CDD__PGP_PASSPHRASE": "dev-pgp-passphrase",
        "GITHUB_ORG_NAME": "offscale"
      },
      "health_check": {
        "type": "command",
        "endpoint": "echo ok",
        "interval_seconds": 30,
        "retries": 3
      }
    },
    {
      "id": "cdd-docs-ui",
      "type": "static",
      "binary_Or_Entrypoint": "npm",
      "args": ["run", "serve"],
      "working_directory": "cdd-docs-ui",
      "port_binding": 8082,
      "environment_overrides": {
        "PORT": "8082",
        "CDD__STORAGE_URL": "http://localhost:8085"
      },
      "health_check": {
        "type": "http",
        "endpoint": "http://localhost:8082",
        "interval_seconds": 10,
        "retries": 6
      }
    },
    {
      "id": "cdd-web-ui",
      "type": "static",
      "binary_Or_Entrypoint": "npx",
      "args": ["--yes", "serve", "-s", "dist/cdd-web-ui/browser", "-l", "8083"],
      "working_directory": "cdd-web-ui",
      "port_binding": 8083,
      "environment_overrides": {
        "PORT": "8083",
        "CDD__WASM_DIR": "cdd-web-ui/public/wasm"
      },
      "health_check": {
        "type": "http",
        "endpoint": "http://localhost:8083",
        "interval_seconds": 10,
        "retries": 6
      }
    },
    {
      "id": "cdd-gateway",
      "type": "proxy",
      "binary_Or_Entrypoint": "bin/cdd-gateway",
      "args": [],
      "working_directory": ".",
      "port_binding": 8086,
      "environment_overrides": {
        "CDD__SERVER_BIND": "0.0.0.0:8086",
        "CDD__GOOGLE_CLIENT_ID": "dev-google-client-id",
        "CDD__GOOGLE_CLIENT_SECRET": "dev-google-client-secret",
        "CDD__GOOGLE_OAUTH_URL": "https://oauth2.googleapis.com/token",
        "CDD__GOOGLE_USERINFO_URL": "https://www.googleapis.com/oauth2/v3/userinfo",
        "CDD__GITHUB_CLIENT_ID": "dev-github-client-id",
        "CDD__GITHUB_CLIENT_SECRET": "dev-github-client-secret",
        "GITHUB_ORG_NAME": "offscale",
        "CDD__STORAGE_URL": "http://localhost:8085",
        "CDD__STORAGE_SECRET_KEY": "dev-secret-key"
      },
      "health_check": {
        "type": "http",
        "endpoint": "http://localhost:8086/health",
        "interval_seconds": 10,
        "retries": 6
      }
    }
  ],
  "ingress": {
    "default_http_port": 8080,
    "default_https_port": 8443,
    "tls_mode": "self-signed",
    "routes": [
      {
        "path_Or_Subdomain": "/api",
        "target_service_id": "cdd-control-plane",
        "target_port": 8081
      },
      {
        "path_Or_Subdomain": "/storage",
        "target_service_id": "cdd-storage",
        "target_port": 8085
      },
      {
        "path_Or_Subdomain": "/docs",
        "target_service_id": "cdd-docs-ui",
        "target_port": 8082
      },
      {
        "path_Or_Subdomain": "/",
        "target_service_id": "cdd-web-ui",
        "target_port": 8083
      }
    ]
  },
  "directories": {
    "app_default": "[ProgramFiles64Folder][ProductName]",
    "data_default": "[CommonAppDataFolder][ProductName]\\data",
    "logs_default": "[CommonAppDataFolder][ProductName]\\logs",
    "backups_default": "[CommonAppDataFolder][ProductName]\\backups"
  },
  "branding_palette": {
    "primary_color": "#0F172A",
    "secondary_color": "#2563EB",
    "dark_color": "#020617",
    "app_title": "CDD Platform"
  },
  "features": [
    {
      "id": "CoreServices",
      "title": "CDD Core Microservices",
      "description": "Installs Control Plane, Gateway, Engine, Storage, and Publisher services.",
      "default": true,
      "mandatory": true,
      "component_dependencies": ["postgres", "valkey", "rust"]
    },
    {
      "id": "WebInterfaces",
      "title": "CDD Web & Documentation UIs",
      "description": "Installs the Angular Web Dashboard and API Documentation portal.",
      "default": true,
      "mandatory": false,
      "component_dependencies": ["nodejs", "nginx"]
    }
  ],
  "lifecycle_hooks": {
    "pre_install": [
      {
        "id": "verify_ports",
        "description": "Verify required CDD service ports are available",
        "command": "echo Verifying CDD platform prerequisites",
        "optional": true
      }
    ],
    "post_install": [
      {
        "id": "init_cdd_db",
        "description": "Initialize PostgreSQL cdd database",
        "command": "psql -h localhost -U postgres -c \"CREATE DATABASE cdd\"",
        "optional": true
      }
    ]
  }
}
